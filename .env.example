# Copy to .env and fill in. Never commit the real .env file.

# SQL Server connection string (the database must already have the schema, see backend/database/)
DB_CONNECTION_STRING=Server=your-sql-server,1433;Database=MySalesCompany;User Id=sales_app;Password=change-me;TrustServerCertificate=True

# JWT signing key, at least 32 characters
CERTIFICATE_KEY=replace-with-a-long-random-secret-of-32+-chars

# Local S3 with LocalStack (docker-compose.localstack.yml): token from https://app.localstack.cloud
# (free Hobby plan for non-commercial use). AWSKEY/AWSKEYSECRET/BUCKETNAME are set by that file.
LOCALSTACK_AUTH_TOKEN=

# Weekly Excel report upload to S3 (set to false if S3 is not configured)
WEEKLY_REPORT_ENABLED=true
AWSKEY=
AWSKEYSECRET=
BUCKETNAME=

# SMTP password of the company mailbox and address that receives stock alerts
PASSGREATEINDUSTRIES=
MYOWNEMAIL=
